# Optional: point at a custom mind API host (default: same origin /api)
# VITE_MIND_API_URL=

# Force hash router only if the host has no SPA rewrites
# VITE_HASH_ROUTER=1

# Google Sign-In — removed (wallet-only). Do not set.
# VITE_GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_ID=

# Durable DB (Turso) — persists wallet-linked sessions / lots on Vercel
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
# Robinhood Chain (EVM) — same stack as mindlessrh.net
# Mainnet 4663 / Testnet 46630
# VITE_RH_CHAIN_ID=46630
# RH_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
# VITE_RH_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
# Mainnet RPC (when not on testnet):
# RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# VITE_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# EXO_TOKEN=0x…          # ERC-20 $EXO on RH Chain (server)
# VITE_EXO_TOKEN=0x…     # same for public balance UI
# VITE_EXO_CA=0x…        # Hero CA display (falls back to VITE_EXO_TOKEN)
# VITE_CLAIM_CONTRACT=0x…  # claim/burn contract — when set + token, on-chain claim goes live
# CLAIM_CONTRACT=0x…       # optional server mirror of claim contract

# Legacy (deprecated — Solana SPL no longer used)
# EXO_MINT=
# VITE_EXO_MINT=
# SOLANA_RPC_URL=

# Public social / market links (omit = shows "soon" in footer, hidden Follow)
# VITE_X_URL=https://x.com/…
# VITE_GITHUB_URL=https://github.com/…
# VITE_DEX_URL=https://dexscreener.com/…
# VITE_TELEGRAM_URL=https://t.me/…

# REQUIRED for Trust / phone QR connect (https://cloud.reown.com → Create project → Project ID)
# Without this, WalletConnect is disabled and mobile wallets cannot link.
# VITE_WALLETCONNECT_PROJECT_ID=

# Gemini (server / Vercel env — never VITE_). Required for live Mind.
# Without GEMINI_API_KEY, /api/chat returns thin "signal degraded" — not a fake FAQ.
# After setting on Vercel: Redeploy. Check GET /api/health → { "gemini": true }
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
