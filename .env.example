# Optional: point at a custom mind API host (default: same origin /api)
# VITE_MIND_API_URL=

# Force hash router only if the host has no SPA rewrites
# VITE_HASH_ROUTER=1

# Google Sign-In — removed (wallet-only). Do not set.
# VITE_GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_ID=

# Durable DB (Turso) — persists wallet-linked sessions / lots on Vercel
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
# Robinhood Chain (EVM) — same stack as mindlessrh.net
# Mainnet 4663 / Testnet 46630
# VITE_RH_CHAIN_ID=46630
# RH_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
# VITE_RH_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
# Mainnet RPC (when not on testnet):
# RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# VITE_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Token CA is already defaulted in code ($TEST on Pons). Override if you launch a new one.
# VITE_EXO_TOKEN=0x26feef8a105b282377102308d3769bf9C9E60e76
# VITE_EXO_CA=0x26feef8a105b282377102308d3769bf9C9E60e76
# EXO_TOKEN=0x26feef8a105b282377102308d3769bf9C9E60e76
# VITE_DEX_URL=https://dexscreener.com/robinhood/0x61ce95Ee9d36d83A4776598E14CED9a4648D1A03
# Claim burns 0.001 $TEST per lot. After ExoClaim is deployed, set both:
# VITE_CLAIM_CONTRACT=0x…
# CLAIM_CONTRACT=0x…
# Then new claims lock claimedBy[lot] = buyer on Robinhood Chain.
# Optional: VITE_CLAIM_PRICE_WEI=1000000000000000

# Legacy (deprecated — Solana SPL no longer used)
# EXO_MINT=
# VITE_EXO_MINT=
# SOLANA_RPC_URL=

# Public social / market links
# VITE_X_URL=https://x.com/_voidos
# VITE_GITHUB_URL=https://github.com/…
# VITE_DEX_URL=https://dexscreener.com/…   # makes Buy $EXO open real Dex
# VITE_TELEGRAM_URL=https://t.me/…

# REQUIRED for Trust / phone QR connect (https://cloud.reown.com → Create project → Project ID)
# Without this, WalletConnect is disabled and mobile wallets cannot link.
# VITE_WALLETCONNECT_PROJECT_ID=

# Gemini (server / Vercel env — never VITE_). Required for live Mind.
# Without GEMINI_API_KEY, /api/chat returns thin "signal degraded" — not a fake FAQ.
# After setting on Vercel: Redeploy. Check GET /api/chat → { "gemini": true }
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
