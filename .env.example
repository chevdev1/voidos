# Optional: point at a custom mind API host (default: same origin /api)
# VITE_MIND_API_URL=

# Force hash router only if the host has no SPA rewrites
# VITE_HASH_ROUTER=1

# Durable client DB (Turso / libSQL) — required for persistent accounts on Vercel
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Google Sign-In (same Client ID in both)
# VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Solana
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# EXO_MINT=   # SPL mint address when $EXO exists
# WalletConnect / Robinhood Wallet (https://cloud.reown.com → Project ID)
# VITE_WALLETCONNECT_PROJECT_ID=

# Gemini (server / Vercel env — never VITE_)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
